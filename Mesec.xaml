<!-- Okno aplikace. Načítá ho Mesec.ps1, takže tu nejsou žádné obsluhy událostí, jen vzhled a jména prvků. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Měšec" Width="1080" Height="740" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- Paleta: tmavá zeleň + mátová. Barva Bg se zrcadlí v Mesec.ps1 (titulkový pruh). -->
        <SolidColorBrush x:Key="Bg" Color="#0F1513"/>
        <SolidColorBrush x:Key="Well" Color="#0A0F0D"/>
        <SolidColorBrush x:Key="Surface" Color="#17201C"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#1E2A25"/>
        <SolidColorBrush x:Key="Stroke" Color="#26332D"/>
        <SolidColorBrush x:Key="StrokeHover" Color="#3A4B43"/>
        <SolidColorBrush x:Key="Text" Color="#E8F0EB"/>
        <SolidColorBrush x:Key="Muted" Color="#8A9A91"/>
        <SolidColorBrush x:Key="Accent" Color="#5AD1A0"/>
        <SolidColorBrush x:Key="AccentHover" Color="#7ADDB5"/>
        <SolidColorBrush x:Key="AccentPressed" Color="#46B98A"/>
        <SolidColorBrush x:Key="AccentTint" Color="#1C5AD1A0"/>
        <SolidColorBrush x:Key="OnAccent" Color="#06231A"/>
        <SolidColorBrush x:Key="Danger" Color="#FF8A80"/>
        <!-- Sloupce ostatních měsíců: šedá, ať vynikne ten vybraný -->
        <SolidColorBrush x:Key="BarMuted" Color="#5C7368"/>
        <SolidColorBrush x:Key="Scrim" Color="#CC070B09"/>

        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" CornerRadius="13" BorderThickness="2"
                                BorderBrush="{StaticResource Accent}" Opacity="0.8"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MaxWidth" Value="280"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Úzký posuvník bez šipek -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource StrokeHover}" CornerRadius="3" Margin="3,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>

        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Velké číslo v dlaždici -->
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>

        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Margin" Value="9,0"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Stroke" Value="{StaticResource Muted}"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>

        <!-- Špatný PIN: tečky se zatřesou -->
        <Storyboard x:Key="Shake">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="-9"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.10" Value="9"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="-6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.20" Value="6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="-3"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionOpacity" Value="0.3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{StaticResource Well}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vedlejší akce. ButtonBase, aby styl sedl i na RepeatButton ve vybírátku měsíce. -->
        <Style x:Key="QuietButton" TargetType="ButtonBase">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Šipky mezi měsíci a roky: znak ze Segoe MDL2 Assets -->
        <Style x:Key="NavButton" TargetType="ButtonBase" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Řádek rozpisu: celý je tlačítko, které otevře úpravu -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="6,7,10,7">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pole, které se nevyplňuje psaním: kliknutím otevře vybírátko -->
        <Style x:Key="FieldButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Well}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="9" Padding="12,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stín pod vybírátkem. Je na vlastním rámečku pod kartou, aby efekt nerozmazal text v ní. -->
        <Style x:Key="PopupShadow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.55"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tlačítko, které se ozve až pod myší: sloupec grafu a název měsíce v záhlaví -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Štítek: typ ve formuláři, měsíc a den ve vybírátku -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Pozadí má i mřížka, ne jen okno: obrázek z -Screenshot se bere z ní. -->
    <Grid Background="{StaticResource Bg}">

        <!-- Přehled měsíce -->
        <Grid x:Name="MainView" Margin="24,16,24,20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrevButton" Style="{StaticResource NavButton}" Content="&#xE76B;"
                            ToolTip="Předchozí měsíc" AutomationProperties.Name="Předchozí měsíc"/>
                    <!-- Název měsíce otevírá vybírátko měsíce a roku. -->
                    <Button x:Name="MonthButton" Style="{StaticResource GhostButton}" Width="188" Height="36" Margin="4,0"
                            ToolTip="Vybrat měsíc a rok" AutomationProperties.Name="Vybrat měsíc a rok">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="MonthText" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}"
                                       TextOptions.TextFormattingMode="Ideal"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="9,4,0,0"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource NavButton}" Content="&#xE76C;"
                            ToolTip="Další měsíc" AutomationProperties.Name="Další měsíc"/>
                    <Button x:Name="TodayButton" Style="{StaticResource QuietButton}" Content="Tento měsíc" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel x:Name="VaultButtons" Orientation="Horizontal">
                        <Button x:Name="BackupButton" Style="{StaticResource QuietButton}" Content="Záloha"
                                ToolTip="Uloží zašifrovanou kopii dat do souboru. Hodí se před přeinstalací Windows."/>
                        <Button x:Name="PinButton" Style="{StaticResource QuietButton}" Content="Změnit PIN" Margin="8,0"/>
                        <Button x:Name="LockButton" Style="{StaticResource QuietButton}" Content="Zamknout"/>
                    </StackPanel>
                    <!-- Jen když Měšec pustila Bránocesta; ukazuje ho Mesec.ps1. Stojí mimo VaultButtons, ať je vidět i v ukázce. -->
                    <Button x:Name="GatewayButton" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Visibility="Collapsed"
                            ToolTip="Zavře Měšec a otevře Bránocestu." AutomationProperties.Name="Zpět na Bránocestu">
                        <TextBlock>
                            <Run FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE72B;"/>
                            <Run Text=" Bránocesta"/>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>

            <UniformGrid Grid.Row="1" Rows="1" Margin="-6,16,-6,0">
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Příjmy"/>
                        <TextBlock x:Name="IncomeText" Style="{StaticResource Figure}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Výdaje"/>
                        <TextBlock x:Name="ExpensesText" Style="{StaticResource Figure}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0">
                    <StackPanel>
                        <TextBlock x:Name="LeftLabel" Style="{StaticResource SectionLabel}" Text="Zbývá"/>
                        <TextBlock x:Name="LeftText" Style="{StaticResource Figure}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Rozpis pravidelných plateb -->
                <Border Style="{StaticResource Card}" Padding="12,14,6,8">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="6,0,12,10">
                            <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="+  Přidat"/>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Pravidelné platby"/>
                        </DockPanel>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ItemsControl x:Name="Rows" Focusable="False" Margin="0,0,6,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" AutomationProperties.Name="{Binding Name}">
                                                <!-- MinHeight: řádek bez poznámky pod názvem je stejně vysoký jako s ní. -->
                                                <Grid MinHeight="34">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="118"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Day}" Foreground="{StaticResource Muted}"
                                                               FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="Note" Text="{Binding Note}" Style="{StaticResource Small}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Height="22" CornerRadius="11" Padding="9,0" Margin="10,0"
                                                            VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource Stroke}">
                                                        <TextBlock Text="{Binding Category}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="3" Text="{Binding Amount}" FontSize="14" FontWeight="SemiBold"
                                                               TextAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Note}" Value="">
                                                    <Setter TargetName="Note" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="EmptyText" Style="{StaticResource Small}" FontSize="13" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       Text="Tenhle měsíc je prázdný.&#10;Přidej první pravidelnou platbu nebo příjem tlačítkem nahoře."/>
                        </Grid>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Výdaje po typech: jedna barva, seřazeno od největšího -->
                    <Border Style="{StaticResource Card}" Padding="18,14,8,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="Kam jdou peníze" Margin="0,0,0,12"/>
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <ItemsControl x:Name="Breakdown" Focusable="False" Margin="0,0,10,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,11">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right">
                                                            <Run Text="{Binding Amount, Mode=OneWay}"/>
                                                            <Run Text="{Binding Share, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                    </DockPanel>
                                                    <Grid Height="6" Margin="0,5,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{Binding Fill}"/>
                                                            <ColumnDefinition Width="{Binding Rest}"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{StaticResource Accent}" CornerRadius="3" MinWidth="4"/>
                                                    </Grid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="BreakdownEmpty" Style="{StaticResource Small}" Text="Žádné výdaje."
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <!-- Výdaje po měsících: vybraný měsíc barevně, čárkovaně průměr -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14,18,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock x:Name="AverageText" DockPanel.Dock="Right" Style="{StaticResource Small}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="YearTitle" Style="{StaticResource CardTitle}"/>
                            </DockPanel>
                            <Grid Height="104">
                                <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource Stroke}"/>
                                <ItemsControl x:Name="Bars" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="{Binding Rest}"/>
                                                        <RowDefinition Height="{Binding Fill}"/>
                                                    </Grid.RowDefinitions>
                                                    <Border x:Name="Bar" Grid.Row="1" Margin="4,0" CornerRadius="4,4,0,0"
                                                            Background="{StaticResource BarMuted}"/>
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Current}" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource Accent}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid x:Name="AverageMark" IsHitTestVisible="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition x:Name="AverageRest" Height="1*"/>
                                        <RowDefinition x:Name="AverageFill" Height="1*"/>
                                    </Grid.RowDefinitions>
                                    <Line Grid.Row="1" X2="1" Stretch="Fill" VerticalAlignment="Top" StrokeThickness="1"
                                          Stroke="{StaticResource Text}" Opacity="0.55" StrokeDashArray="4 4"/>
                                </Grid>
                            </Grid>
                            <ItemsControl x:Name="BarLabels" Focusable="False" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="11" TextAlignment="Center"
                                                   Foreground="{StaticResource Muted}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Current}" Value="True">
                                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}"/>
                                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- Formulář platby -->
        <Grid x:Name="EditorView" Background="{StaticResource Scrim}" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="540" Padding="24,20,24,22" VerticalAlignment="Center"
                    BorderBrush="{StaticResource StrokeHover}">
                <StackPanel>
                    <TextBlock x:Name="EditorTitle" FontSize="18" FontWeight="SemiBold"/>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="Název" Margin="0,16,0,6"/>
                    <TextBox x:Name="NameBox" MaxLength="60" AutomationProperties.Name="Název"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Částka v Kč" Margin="0,0,0,6"/>
                            <TextBox x:Name="AmountBox" MaxLength="14" AutomationProperties.Name="Částka v Kč"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Den v měsíci" Margin="0,0,0,6"/>
                            <Button x:Name="DayButton" Style="{StaticResource FieldButton}" AutomationProperties.Name="Den v měsíci"
                                    ToolTip="Kolikátého se platba každý měsíc dělá."/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Příjemce" Margin="0,0,0,6"/>
                            <TextBox x:Name="ToBox" MaxLength="60" AutomationProperties.Name="Příjemce"
                                     ToolTip="Komu nebo na jaký účet platba jde. U příjmu od koho přichází."/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource SectionLabel}" Text="Typ" Margin="0,14,0,8"/>
                    <WrapPanel x:Name="Categories"/>

                    <!-- Poslední měsíc, kdy se ještě platí, nebo bez omezení. Volí se ve vybírátku. -->
                    <TextBlock Style="{StaticResource SectionLabel}" Text="Platí do" Margin="0,8,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="UntilButton" Style="{StaticResource FieldButton}" Width="190" AutomationProperties.Name="Platí do"/>
                        <TextBlock Style="{StaticResource Small}" Text="poslední měsíc, kdy se ještě platí"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="EditorStatus" Style="{StaticResource Small}" TextWrapping="Wrap" MinHeight="32" Margin="0,12,0,0"/>

                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Uložit" MinWidth="110"/>
                        <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Zrušit" Margin="0,0,8,0"/>
                        <!-- Smazat se zeptá, jestli jen zobrazený měsíc, nebo i další. Tlačítka střídá Mesec.ps1. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="DeleteButton" Style="{StaticResource QuietButton}" Content="Smazat"
                                    Foreground="{StaticResource Danger}"/>
                            <StackPanel x:Name="DeleteChoices" Orientation="Horizontal">
                                <Button x:Name="DeleteMonthButton" Style="{StaticResource QuietButton}" Content="Jen tenhle měsíc"
                                        Foreground="{StaticResource Danger}" Margin="0,0,8,0"/>
                                <Button x:Name="DeleteOnwardButton" Style="{StaticResource QuietButton}" Content="I všechny další"
                                        Foreground="{StaticResource Danger}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Vybírátka: den, měsíc ani rok se nikde nepíšou. Štítky do nich doplní Mesec.ps1.
             Okraj mřížky je místo pro stín; HorizontalOffset ho vrací zpátky pod levý okraj tlačítka. -->

        <!-- Den v měsíci -->
        <Popup x:Name="DayPicker" StaysOpen="False" AllowsTransparency="True" Placement="Bottom"
               PlacementTarget="{Binding ElementName=DayButton}" HorizontalOffset="-14" VerticalOffset="4">
            <Grid Margin="14,0,14,18">
                <Border Style="{StaticResource PopupShadow}"/>
                <Border Style="{StaticResource Card}" Width="300" Padding="12,12,12,6" BorderBrush="{StaticResource StrokeHover}">
                    <!-- Záporný okraj vyrovnává mezeru, kterou má každý štítek vpravo. -->
                    <UniformGrid x:Name="PickerDays" Columns="7" Margin="0,0,-6,0"/>
                </Border>
            </Grid>
        </Popup>

        <!-- Měsíc a rok. Mesec.ps1 ho otevírá pod tlačítkem, ke kterému zrovna patří. -->
        <Popup x:Name="MonthPicker" StaysOpen="False" AllowsTransparency="True" Placement="Bottom"
               HorizontalOffset="-14" VerticalOffset="4">
            <Grid Margin="14,0,14,18">
                <Border Style="{StaticResource PopupShadow}"/>
                <Border Style="{StaticResource Card}" Width="300" Padding="12" BorderBrush="{StaticResource StrokeHover}">
                    <StackPanel>
                        <DockPanel>
                            <!-- Podržením tlačítka roky běží samy. -->
                            <RepeatButton x:Name="PickerPrevYear" DockPanel.Dock="Left" Style="{StaticResource NavButton}"
                                          Content="&#xE76B;" Delay="400" Interval="110"
                                          ToolTip="Předchozí rok" AutomationProperties.Name="Předchozí rok"/>
                            <RepeatButton x:Name="PickerNextYear" DockPanel.Dock="Right" Style="{StaticResource NavButton}"
                                          Content="&#xE76C;" Delay="400" Interval="110"
                                          ToolTip="Další rok" AutomationProperties.Name="Další rok"/>
                            <TextBlock x:Name="PickerYear" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <UniformGrid x:Name="PickerMonths" Columns="3" Margin="0,12,-6,0"/>
                        <Button x:Name="PickerClearButton" Style="{StaticResource QuietButton}" Content="Bez omezení" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>

        <!-- Zámek: zadání nebo volba PINu. Číslice chytá okno, žádné pole tu není. -->
        <Grid x:Name="LockView" Background="{StaticResource Bg}" Focusable="True" FocusVisualStyle="{x:Null}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340" Margin="0,0,0,40">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="30" HorizontalAlignment="Center"
                           Foreground="{StaticResource Accent}"/>
                <TextBlock Text="Měšec" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"
                           TextOptions.TextFormattingMode="Ideal"/>
                <TextBlock x:Name="LockPrompt" FontSize="14" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform/>
                    </StackPanel.RenderTransform>
                    <Ellipse Style="{StaticResource Dot}"/>
                    <Ellipse Style="{StaticResource Dot}"/>
                    <Ellipse Style="{StaticResource Dot}"/>
                    <Ellipse Style="{StaticResource Dot}"/>
                </StackPanel>
                <TextBlock x:Name="LockStatus" Style="{StaticResource Small}" TextWrapping="Wrap" TextAlignment="Center"
                           MinHeight="34" Margin="0,24,0,0"/>
                <Button x:Name="RestoreButton" Style="{StaticResource QuietButton}" Content="Obnovit ze zálohy…"
                        HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <!-- Zpátky do brány jde i bez PINu. -->
                <Button x:Name="LockGatewayButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Center"
                        Margin="0,10,0,0" Visibility="Collapsed" ToolTip="Zavře Měšec a otevře Bránocestu."
                        AutomationProperties.Name="Zpět na Bránocestu">
                    <TextBlock>
                        <Run FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE72B;"/>
                        <Run Text=" Bránocesta"/>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
